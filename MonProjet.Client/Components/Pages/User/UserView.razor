@page "/users"
@using MonProjet.Client.Models.User
@using MonProjet.Client.View.User
@inherits OwningComponentBase
@implements IUserView

<PageTitle>Utilisateurs</PageTitle>

<h1>@Presenter.ViewModel.Title</h1>
<AppCard>
    <AppStackPanel Orientation="StackOrientation.Horizontal" Gap="8">
        <AppButton Text="Recharger la liste" OnClick="Presenter.LoadUsersAsync" Loading="Presenter.ViewModel.IsLoading" />
    </AppStackPanel>

    @if (Presenter.ViewModel.IsLoading)
    {
        <AppProgressRing Visible="true" />
    }
    else
    {
        <AppDataGrid TItem="UserDto" Items="Presenter.ViewModel.Users" Columns="_columns" />
    }

    <InfoBar Visible="@(Presenter.ViewModel.ErrorMessage is not null)"
             Severity="InfoBar.InfoSeverity.Error"
             Message="@Presenter.ViewModel.ErrorMessage"
             OnDismiss="() => Presenter.ViewModel.ErrorMessage = null" />

    <AppMultiSelect TItem="UserDto"
                    Items="_users"
                    MarginTop="16px"
                    @bind-SelectedItems="_selectedUsers"
                    ValueSelector="u => u.Id.ToString()"
                    LabelSelector="u => u.Name"
                    Placeholder="Assigner à des utilisateurs..." />
</AppCard>

<AppCard MarginTop="24px">
    <AppGridView TItem="UserDto"
                 Items="_users"
                 Columns="3"
                 Gap="24px"
                 MarginTop="24px">

        <ItemTemplate Context="user">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: #dbeafe; color: #1e40af; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                    @user.Name[0]
                </div>
                <div>
                    <div style="font-weight: 600;">@user.Name</div>
                    <div style="font-size: 12px; color: #64748b;">@user.Email</div>
                </div>
            </div>
        </ItemTemplate>

    </AppGridView>
</AppCard>

