@page "/employees"
@using MonProjet.Client.Components.Layout.Tabs
@using MonProjet.Client.Components.UI.Enums.Text
@using MonProjet.Client.Models.Pages.Employee
@using MonProjet.Client.View.Employee
@inherits OwningComponentBase
@implements IEmployeeView
@implements IDisposable

<PageTitle>Employés</PageTitle>

<AppBreadcrumb Items="_breadcrumbItems" MarginBottom="16px" />

<h1>@Presenter.ViewModel.Title</h1>

<AppTabs Variant="AppTabs.TabVariant.Pill" MarginTop="24px">

    <!-- Onglet 1 : Le Tableau de données -->
    <AppTabPanel Title="Liste des employés" Icon="📋">
        <AppStackPanel Orientation="StackOrientation.Horizontal" Gap="8" MarginBottom="16px">
            <AppButton Text="Recharger" OnClick="Presenter.LoadEmployeesAsync" Loading="Presenter.ViewModel.IsLoading" />
        </AppStackPanel>

        @if (Presenter.ViewModel.IsLoading)
        {
            <AppProgressRing Visible="true" />
        }
        else
        {
            <AppDataGrid TItem="EmployeeDto"
                         Items="Presenter.ViewModel.Employees"
                         Columns="_columns"
                         RowClassSelector="GetRowClass"
                         OnRowClick="HandleRowClick"
                         PageSize="5"
                         ShowPagination="true"
                         MarginBottom="16px" />
        }
        <AppButton Text="Sauvegarder" OnClick="SaveData" />
    </AppTabPanel>

    <!-- Onglet 2 : Un espace statistiques (exemple) -->
    <AppTabPanel Title="Statistiques RH" Icon="📊">
        <AppGrid Columns="2" Gap="16">
            <AppCard>
                <TextBlock Text="Total Employés" Variant="TextVariant.Muted" />
                <TextBlock As="TextElement.H2" Variant="TextVariant.Bold" Text="@Presenter.ViewModel.Employees.Count.ToString()" />
            </AppCard>
            <AppCard>
                <TextBlock Text="Employés Actifs" Variant="TextVariant.Muted" />
                <TextBlock As="TextElement.H2" Variant="TextVariant.Bold" Text="@Presenter.ViewModel.Employees.Count(e => e.IsActive).ToString()" />
            </AppCard>
        </AppGrid>
    </AppTabPanel>

</AppTabs>

<InfoBar IsVisible="@(!string.IsNullOrWhiteSpace(Presenter.ViewModel.ErrorMessage))"
         Severity="InfoSeverity.Error"
         Message="@Presenter.ViewModel.ErrorMessage"
         OnDismiss="() => Presenter.ViewModel.ErrorMessage = null" />

<TextBlock Text="Assigner un employé à un projet :"
            Variant="TextVariant.Bold" />

<AutoSuggestBox TItem="EmployeeDto"
                Items="Presenter.ViewModel.Employees"
                @bind-Value="_selectedEmployee"
                TextSelector='@(e => $"{e.Name} ({e.Role})")'
                Placeholder="Rechercher un employé par nom..."
                MarginTop="16px" />

@if (_selectedEmployee is not null)
{
    <AppCard MarginTop="16px" class="highlight-card">
        <TextBlock Text="Détails de l'employé sélectionné :" Variant="TextVariant.Bold" MarginBottom="16px" />
        <AppCard>
            <AppStackPanel Orientation="StackOrientation.Vertical" Gap="8">
                <div style="display: flex; gap: 8px;">
                    <TextBlock As="TextElement.Span" Variant="TextVariant.Bold" Text="Nom :" />
                    <TextBlock As="TextElement.Span" Text="@_selectedEmployee.Name" />
                </div>
                <div style="display: flex; gap: 8px;">
                    <TextBlock As="TextElement.Span" Variant="TextVariant.Bold" Text="Email :" />
                    <TextBlock As="TextElement.Span" Text="@_selectedEmployee.Email" />
                </div>
                <div style="display: flex; gap: 8px;">
                    <TextBlock As="TextElement.Span" Variant="TextVariant.Bold" Text="Rôle :" />
                    <TextBlock As="TextElement.Span" Text="@_selectedEmployee.Role" />
                </div>
            </AppStackPanel>
        </AppCard>
    </AppCard>
}
