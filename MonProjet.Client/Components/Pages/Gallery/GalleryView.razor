@page "/gallery"
@using MonProjet.Client.Components.Layout.Tabs
@using MonProjet.Client.Components.UI.Collections
@using MonProjet.Client.Components.UI.Collections.Column
@using MonProjet.Client.Components.UI.Enums
@using MonProjet.Client.Components.UI.Enums.Text
@using MonProjet.Client.Components.UI.Helpers
@using MonProjet.Client.Components.UI.Layout
@using MonProjet.Client.Models.Pages.Gallery
@using MonProjet.Client.Models.UI.Menu
@using MonProjet.Client.Presenters.Gallery
@inherits OwningComponentBase
@implements IGalleryView
@implements IDisposable

<PageTitle>Galerie de Composants</PageTitle>

<h1 style="margin-bottom: 32px;">Galerie de Composants UI</h1>

<AppGrid Columns="2" Gap="24px">

    <!-- SECTION : BASIC INPUT -->
    <AppCard>
        <h3>Basic Input</h3>
        <AppStackPanel Orientation="StackOrientation.Vertical" Gap="16">
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <AppButton Text="Primaire" Variant="ButtonVariant.Primary" />
                <AppButton Text="Secondaire" Variant="ButtonVariant.Secondary" />
                <AppButton Text="Danger" Variant="ButtonVariant.Danger" />
                <AppButton Text="Chargement" Loading="true" />
            </div>

            <AppCheckBox @bind-Value="_isChecked" Label="Case à cocher (CheckBox)" id="checkbox1" />
            <AppToggleSwitch @bind-Value="_isToggled" Label="Interrupteur (ToggleSwitch)" Position="LabelPlacement.Before" />

            <AppStackPanel Orientation="StackOrientation.Vertical" Gap="8">
                <TextBlock Text="Choisissez votre plan :" Variant="TextVariant.Bold" MarginBottom="8px" />

                <AppRadioButton GroupName="plans"
                                Value="basic"
                                @bind-CurrentValue="_radioValue"
                                Label="Plan Basique (Gratuit)" />

                <AppRadioButton GroupName="plans"
                                Value="pro"
                                @bind-CurrentValue="_radioValue"
                                Label="Plan Pro (9.99$/mois)" />

                <AppRadioButton GroupName="plans"
                                Value="enterprise"
                                @bind-CurrentValue="_radioValue"
                                Label="Plan Entreprise (Sur devis)" />
            </AppStackPanel>

            <AppComboBox TItem="string" Items="Presenter.ViewModel.Suggestions" id="select-langage"
                         @bind-SelectedItem="_selectedCombo" Placeholder="Sélectionnez un langage..." />

            <AppDropDownButton Text="Options du projet" MarginTop="16px">
                <!-- Le contenu du menu -->
                <div style="display: flex; flex-direction: column; gap: 2px;">
                    <button @onclick="() => EditProject()">✏️ Modifier</button>
                    <button @onclick="() => DuplicateProject()">📄 Dupliquer</button>
                    <button style="color: #dc2626 !important;" @onclick="() => DeleteProject()">🗑️ Supprimer</button>
                </div>
            </AppDropDownButton>

            <AppNumberBox TValue="int" @bind-Value="_quantite" Min="1" Max="10" />
            <AppNumberBox
                @bind-Value="_prix"
                id="age-input"
                TValue="decimal"
                Step="0.5m" 
                Min="0m" 
                Placeholder="Prix en €" />

            <div style="max-width: 400px; margin-top: 20px;">
                <TextBlock Text="Volume : " Variant="TextVariant.Bold" MarginBottom="8px" /> @_volume %
                <AppRangeSlider TValue="int" @bind-Value="_volume" Min="0" Max="100" />
            </div>

            <AppMultiSelect TItem="string"
                            Items="_allTags"
                            @bind-SelectedItems="_selectedTags"
                            Placeholder="Choisissez des tags..." />

            <AppStackPanel Orientation="StackOrientation.Vertical" Gap="16">
                <div>
                    <TextBlock Text="Date de naissance" Variant="TextVariant.Bold" MarginBottom="8px" />
                    <AppDatePicker @bind-Value="_dateNaissance"
                                   Placeholder="Sélectionnez votre date de naissance..." />
                </div>

                <InfoBar IsVisible="@(_dateNaissance.HasValue)"
                         Severity="InfoSeverity.Success"
                         Message="@($"Date sélectionnée : {_dateNaissance:dd/MM/yyyy}")" />
            </AppStackPanel>

        </AppStackPanel>
    </AppCard>

    <!-- SECTION : TEXT -->
    <AppCard>
        <h3>Text</h3>
        <AppStackPanel Orientation="StackOrientation.Vertical" Gap="16">
            <AppTextBox @bind-Value="_textValue" Placeholder="Saisissez du texte..." />
            <AppTextBox @bind-Value="_recherche"
                        Placeholder="Rechercher..."
                        LeadingIcon="🔍"
                        ShowClearButton="true" />
            <AppTextBox @bind-Value="_email"
                        Placeholder="Votre adresse email"
                        InputType="email"
                        LeadingIcon="📧"
                        ShowClearButton="true"
                        ValidationFunc="@IsValidEmail"
                        ErrorMessage="Veuillez saisir une adresse email valide." />

            <AutoSuggestBox TItem="string"
                               Items="Presenter.ViewModel.Suggestions"
                               @bind-Value="_suggestValue"
                               Placeholder="Rechercher une langue..." />

            <TextBlock Text="Texte normal" Variant="TextVariant.Normal" />
            <TextBlock Text="Texte discret (Muted)" Variant="TextVariant.Muted" />
            <TextBlock Text="Texte en gras" Variant="TextVariant.Bold" />
            <TextBlock Text="Petit texte" Variant="TextVariant.Small" />

            <div style="margin-top: 16px;">
                <TextBlock Text="Monaco Editor :" Variant="TextVariant.Bold" />
                <MonacoEditor @bind-Value="_codeValue" Height="150px" Language="csharp" />
            </div>
        </AppStackPanel>
    </AppCard>

    <!-- SECTION : FEEDBACK -->
    <AppCard>
        <h3>Feedback</h3>
        <AppStackPanel Orientation="StackOrientation.Vertical" Gap="16">
            <InfoBar IsVisible="true" Message="Ceci est une information." Severity="InfoSeverity.Info" />
            <InfoBar IsVisible="true" Message="Opération réussie !" Severity="InfoSeverity.Success" />
            <InfoBar IsVisible="true" Message="Attention, risque d'erreur." Severity="InfoSeverity.Warning" />
            <InfoBar IsVisible="true" Message="Une erreur est survenue." Severity="InfoSeverity.Error" />

            <AppStackPanel Orientation="StackOrientation.Horizontal"
                           CrossAxisAlignment="StackAlignment.Center"
                           Gap="32"
                           MarginBottom="16px">
                <AppProgressRing />
                <AppProgressRing Size="20px" Thickness="2px" />
                <AppProgressRing Size="48px" Thickness="5px" />
                <AppProgressRing Variant="ProgressRingVariant.Success" />
                <AppProgressRing Variant="ProgressRingVariant.Danger" />
                <AppProgressRing IsVisible="false" />
            </AppStackPanel>

            <AppStackPanel Orientation="StackOrientation.Horizontal"
                           CrossAxisAlignment="StackAlignment.Center"
                           Gap="32">

                <!-- 1. Solde / Portefeuille -->
                <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="8">
                    <FontIcon Icon="💰" Size="20px" Variant="IconVariant.Success" />
                    <TextBlock Text="Solde" Variant="TextVariant.Bold" />
                </AppStackPanel>

                <!-- 2. Investissement / Croissance -->
                <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="8">
                    <FontIcon Icon="📈" Size="20px" Variant="IconVariant.Success" />
                    <TextBlock Text="Investissements" Variant="TextVariant.Bold" />
                </AppStackPanel>

                <!-- 3. Dépenses / Perte -->
                <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="8">
                    <FontIcon Icon="📉" Size="20px" Variant="IconVariant.Danger" />
                    <TextBlock Text="Dépenses" Variant="TextVariant.Bold" />
                </AppStackPanel>

            </AppStackPanel>

            <AppStackPanel Orientation="StackOrientation.Horizontal"
                           CrossAxisAlignment="StackAlignment.Center"
                           Gap="32">
                <!-- 4. Carte de paiement / Transactions -->
                <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="8">
                    <FontIcon Icon="💳" Size="20px" Variant="IconVariant.Primary" />
                    <TextBlock Text="Transactions" Variant="TextVariant.Bold" />
                </AppStackPanel>

                <!-- 5. Compte Bancaire -->
                <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="8">
                    <FontIcon Icon="🏦" Size="20px" />
                    <TextBlock Text="Banques" Variant="TextVariant.Normal" />
                </AppStackPanel>

                <!-- 6. Facturation -->
                <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="8">
                    <FontIcon Icon="🧾" Size="20px" />
                    <TextBlock Text="Factures" Variant="TextVariant.Normal" />
                </AppStackPanel>

            </AppStackPanel>

            <AppStackPanel Orientation="StackOrientation.Horizontal"
                               CrossAxisAlignment="StackAlignment.Center"
                               Gap="32">

                <!-- 7. Alerte de découvert / Risque -->
                <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="8">
                    <FontIcon Icon="⚠️" Size="20px" Variant="IconVariant.Warning" />
                    <TextBlock Text="Alertes" Variant="TextVariant.Bold" />
                </AppStackPanel>

                <!-- 8. Sécurité / Crypto -->
                <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="8">
                    <FontIcon Icon="🔒" Size="20px" Variant="IconVariant.Muted" />
                    <TextBlock Text="Sécurité" Variant="TextVariant.Muted" />
                </AppStackPanel>

            </AppStackPanel>

            <AppProgressBar Value="65" BarHeight="4px" />
            <AppProgressBar Value="75" BarHeight="16px" Variant="ProgressVariant.Success" />
            <AppProgressBar Value="100" Height="100px" BarHeight="8px" />
            <AppProgressBar Indeterminate="true" />
        </AppStackPanel>
    </AppCard>

    <!-- SECTION : LAYOUT & MENU -->
    <AppCard>
        <h3>Layout & Menu</h3>
        <AppStackPanel Orientation="StackOrientation.Vertical" Gap="16">

            <!-- ✅ AppSplitGrid Integration -->
            <div style="margin-bottom: 8px;">
                <TextBlock Text="SplitGrid (Ratio 1:2)" Variant="TextVariant.Bold" />
                <AppSplitGrid Ratio="SplitRatio.OneToTwo" Gap="8px" Height="80px">
                    <Left>
                        <div style="background: #dbeafe; color: #1e40af; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 4px;">
                            Gauche (1fr)
                        </div>
                    </Left>
                    <Right>
                        <div style="background: #dcfce7; color: #166534; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 4px;">
                            Droite (2fr)
                        </div>
                    </Right>
                </AppSplitGrid>
            </div>

            <div style="margin-bottom: 8px;">
                <TextBlock Text="SplitGrid (Ratio Custom : 300px / 1fr)" Variant="TextVariant.Bold" />
                <AppSplitGrid Ratio="SplitRatio.LeftFixed" Gap="8px" Height="80px">
                    <Left>
                        <div style="background: #fef3c7; color: #92400e; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 4px;">
                            Gauche (300px fixe)
                        </div>
                    </Left>
                    <Right>
                        <div style="background: #f1f5f9; color: #475569; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 4px;">
                            Droite (Prend le reste)
                        </div>
                    </Right>
                </AppSplitGrid>
            </div>
            <!-- Fin AppSplitGrid -->

            <AppExpander Header="Cliquez pour déplier (Expander)" OpenOnStart="true">
                <p>Voici le contenu caché de l'expander.</p>
            </AppExpander>

            <div style="display: flex; gap: 8px;">
                <AppButton Text="Ouvrir Dialog" OnClick="() => _showDialog = true" />
                <AppButton Text="Ouvrir Overlay" OnClick="() => _showOverlay = true" Variant="ButtonVariant.Secondary" />
                <AppButton Text="Plein Écran" OnClick="() => _showFullScreen = true" Variant="ButtonVariant.Ghost" />
            </div>

            <AppPopover Position="PopoverPosition.Bottom">
                <Anchor>
                    <AppButton Text="Afficher les détails" Variant="ButtonVariant.Secondary" />
                </Anchor>
                <Content>
                    <h4>Détails du projet</h4>
                    <p>Ceci est un popover qui se ferme si vous cliquez ailleurs.</p>
                </Content>
            </AppPopover>

            <AppPopover Position="PopoverPosition.Top" TriggerOnHover="true">
                <Anchor>
                    <TextBlock Text="Qu'est-ce que c'est ?" Variant="TextVariant.Bold" />
                </Anchor>
                <Content>
                    <span style="font-size: 0.875rem;">Ceci est un texte d'aide contextuel.</span>
                </Content>
            </AppPopover>

            <ContextMenu Items="_contextMenuItems">
                <div style="padding: 40px; background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 8px; text-align: center; cursor: context-menu;">
                    <h3>Clic droit ici</h3>
                    <p style="color: #64748b; margin: 0;">Testez le menu contextuel</p>
                </div>
            </ContextMenu>

            <AppScrollViewer MaxHeight="100px" Direction="ScrollDirection.Vertical">
                <div style="height: 300px; background: linear-gradient(to bottom, #f1f5f9, #e2e8f0);">
                    Contenu long pour tester le défilement (ScrollViewer).
                </div>
            </AppScrollViewer>

            <AppButton Text="Ouvrir l'éditeur plein écran" OnClick="() => _isEditorOpen = true" />

            <!-- ✅ Le composant gère sa propre fermeture via @bind-IsVisible -->
            <AppFullScreenContainer @bind-IsVisible="_isEditorOpen" Title="Éditeur de code">

                <HeaderActions>
                    <AppButton Text="Enregistrer" Variant="ButtonVariant.Primary" />
                </HeaderActions>

                <ChildContent>
                    <MonacoEditor Height="100%" />
                </ChildContent>

            </AppFullScreenContainer>

        </AppStackPanel>
    </AppCard>

    <!-- SECTION : COLLECTIONS (Pleine largeur) -->
    <AppCard>
        <h3>Collections</h3>
        <AppGrid Columns="2" Gap="24px">

            <AppStackPanel Orientation="StackOrientation.Vertical" Gap="8">
                <TextBlock Text="ListBox" Variant="TextVariant.Bold" />

                <AppListBox TItem="string"
                            Items="Presenter.ViewModel.SuggestionsLangue"
                            @bind-SelectedItem="_selectedLanguage"
                            Height="200px" />

                <TextBlock Text="@($"Langue sélectionnée : {_selectedLanguage}")"
                            Variant="TextVariant.Bold"
                            MarginTop="8px" />
            </AppStackPanel>

            <AppStackPanel Orientation="StackOrientation.Vertical" Gap="8">
                <TextBlock Text="GridView" Variant="TextVariant.Bold" />
                <AppGridView TItem="string" Items="Presenter.ViewModel.Suggestions" Columns="2">
                    <ItemTemplate Context="item">
                        <span style="font-weight: 500;">@item</span>
                    </ItemTemplate>
                </AppGridView>
            </AppStackPanel>

            <AppButton Text="Afficher les détails" OnClick="() => _showOverlay = true" />
        </AppGrid>
    </AppCard>

    <AppCard MarginTop="24px" PaddingBottom="24px">
        <TextBlock Text="DataGrid" Variant="TextVariant.Bold" />
        <AppDataGrid TItem="DemoItem"
                        Items="Presenter.ViewModel.Items"
                        Columns="_dataGridColumns" />
    </AppCard>

    <AppCard>
        <h3>Onglets (Tabs)</h3>
        
        <AppTabs @bind-ActiveTab="_demoTab">
            <AppTabPanel Title="Profil" Icon="👤">
                <AppStackPanel Orientation="StackOrientation.Vertical" Gap="8">
                    <TextBlock Text="Modifiez vos informations personnelles ici." Variant="TextVariant.Muted" />
                    <AppTextBox Placeholder="Nom d'utilisateur" />
                    <AppTextBox Placeholder="Email" />
                </AppStackPanel>
            </AppTabPanel>
            
            <AppTabPanel Title="Sécurité" Icon="🔒">
                <AppStackPanel Orientation="StackOrientation.Vertical" Gap="8">
                    <TextBlock Text="Gérez vos mots de passe et l'authentification à deux facteurs." Variant="TextVariant.Muted" />
                    <AppButton Text="Changer de mot de passe" Variant="ButtonVariant.Secondary" />
                </AppStackPanel>
            </AppTabPanel>
            
            <AppTabPanel Title="Notifications" Icon="🔔">
                <TextBlock Text="Choisissez comment vous souhaitez être notifié." Variant="TextVariant.Muted" />
                <AppToggleSwitch Label="Recevoir les alertes par email" MarginTop="8px" />
            </AppTabPanel>
        </AppTabs>
    </AppCard>
</AppGrid>

<!-- MODALES ET OVERLAYS -->
<AppDialog @bind-IsVisible="_showDialog"
           Title="Confirmer la suppression"
           MaxWidth="400px">

    <ChildContent>
        <p>Êtes-vous sûr de vouloir supprimer cet employé ? Cette action est irréversible.</p>
    </ChildContent>

    <Footer>
        <AppButton Text="Annuler"
                   Variant="ButtonVariant.Secondary"
                   OnClick="() => _showDialog = false" />

        <AppButton Text="Supprimer"
                   Variant="ButtonVariant.Danger"
                   OnClick="DeleteEmployee" />
    </Footer>

</AppDialog>


<AppOverlay @bind-IsVisible="_showOverlay">
    <div style="padding: 24px; width: 400px;">
        <h3>Détails du projet</h3>
        <p>Voici le contenu de l'overlay. Le clic à l'extérieur le fermera.</p>

        <div style="display: flex; justify-content: flex-end; margin-top: 16px;">
            <AppButton Text="Fermer" OnClick="() => _showOverlay = false" />
        </div>
    </div>
</AppOverlay>

@if (_showFullScreen)
{
    <AppFullScreenContainer>
        <div style="display: flex; justify-content: space-between; margin-bottom: 24px;">
            <h2>Mode Plein Écran</h2>
            <AppButton Text="Fermer" Variant="ButtonVariant.Danger" OnClick="() => _showFullScreen = false" />
        </div>
        <p>Ce contenu prend tout l'écran.</p>
    </AppFullScreenContainer>
}

@code {
    // 1. Résolution du présentateur
    private IGalleryPresenter Presenter => ScopedServices.GetRequiredService<IGalleryPresenter>();

    // 2. États pour les composants interactifs
    private bool _isChecked = true;
    private bool _isToggled = false;
    private string _radioValue = "1";
    private string? _selectedCombo;
    private string _textValue = "";
    private string _recherche = "";
    private string _email = "";
    private string? _suggestValue;
    private string _codeValue = "public class Hello { }";
    private bool _isEditorOpen = false;
    // 3. États pour les fenêtres modales
    private bool _showDialog = false;
    private bool _showOverlay = false;
    private bool _showFullScreen = false;

    // 4. Configuration du ContextMenu
    private List<ContextMenuItem> _contextMenuItems = new();

    private void InitializeContextMenu()
    {
        _contextMenuItems = new()
        {
            new() {
                Label = "Modifier",
                Icon = "✏️",
                OnClick = EventCallback.Factory.Create(this, EditAction)
            },
            new() {
                Label = "Dupliquer",
                Icon = "📄",
                OnClick = EventCallback.Factory.Create(this, DuplicateAction)
            },
            ContextMenuItem.Separator(),
            new() {
                Label = "Archiver",
                Icon = "📦",
                OnClick = EventCallback.Factory.Create(this, ArchiveActionAsync)
            },
            new() {
                Label = "Supprimer",
                Icon = "🗑️",
                IsDisabled = true,
                OnClick = EventCallback.Factory.Create(this, DeleteAction)
            }
        };
    }

    private void EditAction()
    {
        Console.WriteLine("Modifié");
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;

        // Validation simple (vous pouvez utiliser une Regex plus complexe)
        return email.Contains("@") && email.Contains(".") && email.Length >= 5;
    }
    private void DuplicateAction() => Console.WriteLine("Dupliqué");
    private async Task ArchiveActionAsync()
    {
        Console.WriteLine("Archivé");
    }
    private void DeleteAction() => Console.WriteLine("Supprimé");

    private int _quantite = 1;
    private decimal _prix = 0m;
    private int _volume = 50;
    private List<string> _allTags = new() { "C#", "Blazor", ".NET", "WASM", "SOLID" };
    private IEnumerable<string> _selectedTags = new List<string> { "Blazor" };
    private DateTime? _dateNaissance;
    private string _selectedLanguage = "";
    private string? _demoTab;

    private void EditProject() { /* Logique */ }
    private void DuplicateProject() { /* Logique */ }
    private void DeleteProject() { /* Logique */ }

    private void DeleteEmployee()
    {
        // Logique de suppression...
        _showDialog = false; // Ferme la modale
    }
    // 5. Configuration du DataGrid
    private readonly List<GridColumn<DemoItem>> _dataGridColumns;

    public GalleryView()
    {
        _dataGridColumns = new List<GridColumn<DemoItem>>
        {
            GridColumn.Text<DemoItem>("ID", i => i.Id, comparer: (a,b) => a.Id.CompareTo(b.Id)),
            GridColumn.Text<DemoItem>("Nom", i => i.Name),
            GridColumn.Template<DemoItem>("Statut", item => builder =>
            {
                var color = item.Status == "Actif" ? "#166534" : "#92400e";
                var bg = item.Status == "Actif" ? "#dcfce7" : "#fef3c7";
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "style", $"background:{bg}; color:{color}; padding:2px 8px; border-radius:12px; font-size:12px; font-weight:600;");
                builder.AddContent(2, item.Status);
                builder.CloseElement();
            }),
            GridColumn.Text<DemoItem>("Quantité", i => i.Count, formatter: raw => $"{raw} unités")
        };
    }

    // 6. Cycle de vie
    protected override async Task OnInitializedAsync()
    {
        Presenter.SetView(this);
        await Presenter.InitializeAsync();
    }
    protected override void OnInitialized()
    {
        InitializeContextMenu();
    }
    public void ShowError(string message) => StateHasChanged();
    public void ShowLoading(bool isLoading) => StateHasChanged();

    // 7. Libération propre
    public void Dispose()
    {
        GC.SuppressFinalize(this);
    }
}