@page "/"
@inherits OwningComponentBase

<div @key="LanguageService.CurrentCulture">
<PageTitle>@Loc["Title"]</PageTitle>

<h1>@Loc["Title"]</h1>
<AppStackPanel Orientation="StackOrientation.Horizontal"
               Gap="12"
               PaddingLeft="0px"
               MainAxisAlignment="StackAlignment.Start"
               CrossAxisAlignment="StackAlignment.Center"
               MarginBottom="24px">

    <AppTextBox id="search-input" 
                name="search" 
                @bind-Value="SearchTerm" 
                @bind-Value:after="RefreshDataAsync"
                Width="400px" 
                PaddingLeft="0px" 
                Placeholder="@Loc["Search_Placeholder"]" />
    <AppButton Text='@Loc["Btn_Refresh"]' OnClick="RefreshDataAsync" Loading="Presenter.ViewModel.IsLoading" />

</AppStackPanel>

@if (Presenter.ViewModel.IsLoading && string.IsNullOrEmpty(SearchTerm))
{
    <AppProgressRing Visible="true" />
}
else
{
    <AppDataGrid TItem="HomeItemDto" Items="Presenter.ViewModel.Items" Columns="_columns" />
}

<InfoBar IsVisible="@(!string.IsNullOrWhiteSpace(Presenter.ViewModel.ErrorMessage))"
         Severity="InfoSeverity.Error"
         Message="@Presenter.ViewModel.ErrorMessage"
         MarginTop="16px"
         OnDismiss="() => Presenter.ViewModel.ErrorMessage = null" />
</div>
