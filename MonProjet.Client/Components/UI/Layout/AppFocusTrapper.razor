@inherits AppComponentBase
@implements IAsyncDisposable

<div @ref="_container" class="app-focus-trapper">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Active { get; set; } = true;

    private ElementReference _container;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Active)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./js/focusTrap.js");
            await _module.InvokeVoidAsync("trap", _container);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("release", _container); } catch { }
            await _module.DisposeAsync();
        }
    }
}