@inherits AppComponentBase
@implements IAsyncDisposable

@if (Visible)
{
    <div class="app-dialog-overlay" @onclick="OnOverlayClick">
        <div class="app-dialog" role="dialog" aria-modal="true" @ref="_dialogRef" @onclick:stopPropagation="true">
            <div class="app-dialog-header">
                <h3>@Title</h3>
                <button class="app-dialog-close" @onclick="Close" aria-label="Fermer">âœ•</button>
            </div>
            <div class="app-dialog-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="app-dialog-footer">@Footer</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool CloseOnOverlay { get; set; } = true;

    private ElementReference _dialogRef;
    private IJSObjectReference? _module;
    private bool _focusTrapActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_focusTrapActive)
        {
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/MonProjet.Client/js/focusTrap.js");
            await _module.InvokeVoidAsync("trap", _dialogRef);
            _focusTrapActive = true;
        }
        else if (!Visible && _focusTrapActive)
        {
            await ReleaseTrap();
        }
    }

    private async Task OnOverlayClick()
    {
        if (CloseOnOverlay) await Close();
    }

    private async Task Close() => await VisibleChanged.InvokeAsync(false);

    private async Task ReleaseTrap()
    {
        if (_module is not null && _focusTrapActive)
        {
            try { await _module.InvokeVoidAsync("release", _dialogRef); } catch { }
        }
        _focusTrapActive = false;
    }

    public async ValueTask DisposeAsync()
    {
        await ReleaseTrap();
        if (_module is not null) await _module.DisposeAsync();
    }
}