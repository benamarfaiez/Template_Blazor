@inherits AppComponentBase

@if (Visible)
{
    <div class="app-dialog-overlay" @onclick="OnOverlayClick">
        <div class="app-dialog"
             role="dialog"
             aria-modal="true"
             @ref="_dialogRef"
             @onclick:stopPropagation="true"
             @attributes="SafeAttributes">

            <div class="app-dialog-header">
                <h3>@Title</h3>
                <button class="app-dialog-close" @onclick="Close" aria-label="Fermer">✕</button>
            </div>

            <div class="app-dialog-body">
                @ChildContent
            </div>

            @if (Footer is not null)
            {
                <div class="app-dialog-footer">
                    @Footer
                </div>
            }

        </div>
    </div>
}