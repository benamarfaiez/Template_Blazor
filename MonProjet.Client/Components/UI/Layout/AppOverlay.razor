@inherits AppComponentBase

@if (IsVisible)
{
    <div class="app-overlay-backdrop" @onclick="OnOverlayClickAsync">

        <AppFocusTrapper Active="TrapFocus && IsVisible">

            <div class="app-overlay-content"
                 role="dialog"
                 aria-modal="true"
                 @onclick:stopPropagation="true"
                 @attributes="SafeAttributes">

                @ChildContent

            </div>

        </AppFocusTrapper>
    </div>
}