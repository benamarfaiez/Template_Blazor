@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="stretch" VerticalAlignment="stretch"
              IsVisible="@IsVisible">

    <div class="@ClassNames("app-splitgrid", AdditionalAttributes?["class"]?.ToString())"
         style="@_finalGridStyles">

        <div class="app-splitgrid-left">@Left</div>
        <div class="app-splitgrid-right">@Right</div>

    </div>

</AppContainer>