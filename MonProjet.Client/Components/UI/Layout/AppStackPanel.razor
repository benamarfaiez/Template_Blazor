@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Stretch" VerticalAlignment="@ContainerAlignment.Stretch"
              IsVisible="@IsVisible">

    <div style="@_finalFlexStyles" class="@ClassNames("app-stackpanel", AdditionalAttributes?["class"]?.ToString())">
        @ChildContent
    </div>

</AppContainer>