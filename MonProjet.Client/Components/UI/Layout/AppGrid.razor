@inherits AppComponentBase

<div class="app-grid" style="@StyleForGrid()">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Columns { get; set; } = 2;
    [Parameter] public string Gap { get; set; } = "16px";
    private string StyleForGrid() => $"display: grid; grid-template-columns: repeat({Columns}, 1fr); gap: {Gap};";
}