@inherits AppComponentBase

<div class="app-popover-wrapper">
    <div class="app-popover-anchor">@Anchor</div>
    @if (_open)
    {
        <div class="app-popover" style="@PositionStyle()">@Content</div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Anchor { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public string Position { get; set; } = "bottom";
    private bool _open;

    public void Toggle() { _open = !_open; StateHasChanged(); }

    private string PositionStyle()
    {
        var (top, left) = Position switch
        {
            "top"   => ("auto", "0"),
            "right" => ("100%", "100%"),
            "left"  => ("100%", "auto"),
            _       => ("100%", "0")
        };
        return $"position: absolute; top: {top}; left: {left}; margin-top: 4px; z-index: 200;";
    }
}