@inherits AppComponentBase

@if (IsVisible)
{
    <div class="app-popover-wrapper"
         tabindex="-1"
         @onfocusout="HandleFocusOutAsync"
         @attributes="SafeAttributes">

        <div class="app-popover-anchor"
             @onclick="ToggleAsync"
             @onmouseenter="OnMouseEnterAsync"
             @onmouseleave="OnMouseLeaveAsync"
             role="button"
             tabindex="0"
             aria-haspopup="dialog"
             aria-expanded="@IsOpen.ToString().ToLowerInvariant()">
            @Anchor
        </div>

        @if (IsOpen)
        {
            <div class="app-popover-content pos-@Position.ToString().ToLowerInvariant()"
                 role="dialog"
                 @onclick:stopPropagation="true">
                @Content
            </div>
        }
    </div>
}