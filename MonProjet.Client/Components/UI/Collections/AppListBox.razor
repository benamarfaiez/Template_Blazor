@typeparam TItem
@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Stretch" VerticalAlignment="@ContainerAlignment.Stretch"
              IsVisible="@IsVisible">

    @if (Items is null || !Items.Any())
    {
        <!-- ✅ État vide -->
        <div class="app-listbox-empty" @attributes="SafeAttributes">
            @if (EmptyTemplate is not null)
            {
                @EmptyTemplate
            }
            else
            {
                <span class="app-listbox-empty-text">Aucun élément disponible.</span>
            }
        </div>
    }
    else
    {
        <ul class="app-listbox" role="listbox" tabindex="0" @attributes="SafeAttributes">
            @foreach (var item in Items)
            {
                var isSelected = Equals(item, SelectedItem);

                <li @key="item"
                    class="app-listbox-item @(isSelected ? "selected" : "")"
                    role="option"
                    aria-selected="@isSelected.ToString().ToLowerInvariant()"
                    @onclick="() => SelectItemAsync(item)">
                    @LabelSelector(item)
                </li>
            }
        </ul>
    }

</AppContainer>