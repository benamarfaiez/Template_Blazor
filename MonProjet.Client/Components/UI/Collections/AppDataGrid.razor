@typeparam TItem
@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Stretch" VerticalAlignment="@ContainerAlignment.Stretch"
              IsVisible="@IsVisible">

    @if (_sortedItems.Count == 0)
    {
        <div class="app-datagrid-empty-state" @attributes="SafeAttributes">
            @if (EmptyTemplate is not null)
            {
                @EmptyTemplate
            }
            else
            {
                <div class="app-datagrid-empty-content">
                    <span class="app-datagrid-empty-icon">📂</span>
                    <span class="app-datagrid-empty-text">Aucune donnée disponible.</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="app-datagrid-container" @attributes="SafeAttributes">

            <div class="app-datagrid-wrapper">
                <table class="app-datagrid">
                    <AppDataGridHeader TItem="TItem"
                                       Columns="Columns"
                                       SortState="_sortState"
                                       OnSortRequested="HandleSortRequested" />

                    <AppDataGridBody TItem="TItem"
                                     Items="_pagedItems"
                                     Columns="Columns"
                                     RowClassSelector="RowClassSelector"
                                     OnRowClick="OnRowClick" />
                </table>
            </div>

            @if (ShowPagination && _paginationState.TotalPages > 1)
            {
                <AppDataGridPagination CurrentPage="_paginationState.CurrentPage"
                                       TotalPages="_paginationState.TotalPages"
                                       TotalItems="_paginationState.TotalItems"
                                       PageSize="_paginationState.PageSize"
                                       OnPageChanged="HandlePageChanged" />
            }

        </div>
    }

</AppContainer>