@typeparam TItem
@inherits AppComponentBase

<thead @attributes="SafeAttributes">
    <tr>
        @foreach (var col in Columns)
        {
            var sortable = col.Sort.IsSortable;

            <th class="@ClassNames(col.Options.AlignClass, col.Options.HeaderClass, sortable ? "sortable" : null)"
                style="@(col.Options.Width is not null ? $"width: {col.Options.Width};" : null)"
                @key="col"
                role="columnheader"
                aria-sort="@GetAriaSort(col)"
                tabindex="@(sortable ? "0" : "-1")"
                @onclick="() => HandleSortClickAsync(col)"
                @onkeydown="(e) => HandleKeyDownAsync(e, col)">

                <div class="th-content">
                    <span>@col.Header</span>

                    @if (sortable)
                    {
                        <span class="@GetSortIconClass(col)" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 15l5 5 5-5M7 9l5-5 5 5"></path>
                            </svg>
                        </span>
                    }
                </div>
            </th>
        }
    </tr>
</thead>