@typeparam TItem
@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Stretch" VerticalAlignment="@ContainerAlignment.Center"
              IsEnabled="@(!Disabled)" IsVisible="@IsVisible">

    <div class="app-autosuggest" @attributes="SafeAttributes">
        <input type="text"
               class="app-autosuggest-input"
               value="@_searchText"
               @oninput="OnInput"
               @onfocus="OnFocus"
               @onblur="OnBlurAsync"
               @onkeydown="HandleKeyDownAsync"
               placeholder="@Placeholder"
               disabled="@Disabled"
               role="combobox"
               aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
               aria-autocomplete="list" />

        @if (_isOpen && _filteredItems.Count > 0)
        {
            <ul class="app-autosuggest-list" role="listbox">
                @for (int i = 0; i < _filteredItems.Count; i++)
                {
                    var item = _filteredItems[i];
                    var isSelected = i == _selectedIndex;

                    <li @key="item"
                        class="app-autosuggest-item @(isSelected ? "selected" : "")"
                        @onmousedown="() => SelectItemAsync(item)"
                        role="option"
                        aria-selected="@isSelected.ToString().ToLowerInvariant()">
                        @TextSelector(item)
                    </li>
                }
            </ul>
        }
    </div>

</AppContainer>