@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="ContainerAlignment.Stretch" VerticalAlignment="ContainerAlignment.Center"
              IsEnabled="@(!Disabled)" IsVisible="@IsVisible">

    <input type="@InputType"
           id="@CalculatedId"
           name="@Name"
           class="@ClassNames("app-textbox", AdditionalAttributes?["class"]?.ToString())"
           value="@Value"
           @oninput="OnInput"
           placeholder="@Placeholder"
           disabled="@Disabled"
           @attributes="AdditionalAttributes" />

</AppContainer>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string InputType { get; set; } = "text";
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Name { get; set; }

    // Si aucun ID n'est fourni, on en génère un unique pour éviter les avertissements
    private string CalculatedId => Id ?? $"app-input-{Guid.NewGuid():N}";

    private Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }
}