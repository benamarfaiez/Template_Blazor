@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Stretch" VerticalAlignment="@ContainerAlignment.Center"
              IsEnabled="@(!Disabled)" IsVisible="@IsVisible">

    <div class="app-textbox-wrapper @(HasError ? "has-error" : "")" @attributes="SafeAttributes">

        @if (!string.IsNullOrEmpty(LeadingIcon))
        {
            <span class="app-textbox-icon leading" aria-hidden="true">@LeadingIcon</span>
        }

        <input type="@InputType"
               id="@_calculatedId"
               name="@Name"
               class="app-textbox"
               value="@Value"
               @oninput="OnInputAsync"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               maxlength="@MaxLength"
               aria-invalid="@HasError.ToString().ToLowerInvariant()"
               aria-describedby="@AriaDescribedBy" />

        @if (ShowClearButton && !string.IsNullOrEmpty(Value) && !Disabled && !ReadOnly)
        {
            <button type="button" class="app-textbox-clear" @onclick="ClearAsync" aria-label="Effacer le texte">
                ✕
            </button>
        }

        @if (!string.IsNullOrEmpty(TrailingIcon))
        {
            <span class="app-textbox-icon trailing" aria-hidden="true">@TrailingIcon</span>
        }

    </div>

</AppContainer>

@if (HasError && !string.IsNullOrEmpty(ErrorMessage))
{
    <div id="@($"{_calculatedId}-error")" class="app-textbox-error" role="alert">
        @ErrorMessage
    </div>
}