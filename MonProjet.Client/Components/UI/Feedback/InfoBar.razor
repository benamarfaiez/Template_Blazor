@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Stretch" VerticalAlignment="@ContainerAlignment.Center"
              IsVisible="@IsVisible">

    <div class="app-infobar @SeverityClass" role="alert" @attributes="SafeAttributes">

        <span class="app-infobar-icon" aria-hidden="true">@DisplayIcon</span>

        <span class="app-infobar-message">@Message</span>

        @if (OnDismiss.HasDelegate)
        {
            <button type="button" class="app-infobar-dismiss" @onclick="DismissAsync" aria-label="Fermer l'alerte">
                ✕
            </button>
        }

    </div>

</AppContainer>