@inherits AppComponentBase

<div class="app-context-menu-wrapper"
     @oncontextmenu="ShowMenuAsync"
     @oncontextmenu:preventDefault="true"
     @attributes="SafeAttributes">
    @ChildContent
</div>

@if (_isOpen)
{
    <div class="app-context-menu-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault="true"></div>

    <div class="app-context-menu"
         style="@MenuPositionStyle"
         @ref="_menuRef"
         role="menu"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @onclick:stopPropagation="true">

        @foreach (var item in Items)
        {
            if (item.IsSeparator)
            {
                <div class="app-context-menu-separator" role="separator"></div>
            }
            else
            {
                <button type="button"
                        class="app-context-menu-item"
                        role="menuitem"
                        disabled="@item.IsDisabled"
                        @onclick="() => HandleItemClickAsync(item)">

                    <span class="item-icon">@item.Icon</span>
                    <span class="item-label">@item.Label</span>
                    @if (!string.IsNullOrEmpty(item.Shortcut))
                    {
                        <span class="item-shortcut">@item.Shortcut</span>
                    }
                </button>
            }
        }
    </div>
}