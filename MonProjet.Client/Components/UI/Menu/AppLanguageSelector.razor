<AppDropDownButton Text="@CurrentLanguageLabel" Variant="AppButton.ButtonVariant.Ghost">

    <AppStackPanel Orientation="StackOrientation.Vertical"
                   Gap="4"
                   Width="140px"
                   Padding="4">

        <button type="button" class="lang-option" @onmousedown="() => ChangeLanguageAsync(CultureFR)" @onmousedown:preventDefault="true">
            🇫🇷 Français
        </button>

        <button type="button" class="lang-option" @onmousedown="() => ChangeLanguageAsync(CultureEN)" @onmousedown:preventDefault="true">
            🇬🇧 English
        </button>

    </AppStackPanel>

</AppDropDownButton>