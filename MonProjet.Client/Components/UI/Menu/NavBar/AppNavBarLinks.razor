@inherits AppComponentBase

<ul class="app-navbar-links @(IsMobileMenuOpen ? "is-open" : "")" @attributes="SafeAttributes">
    @foreach (var link in Links)
    {
        <li class="app-navbar-item" @key="link"
            @onmouseenter="() => OnMouseEnter.InvokeAsync(link)"
            @onmouseleave="() => OnMouseLeave.InvokeAsync()">

            @if (link.HasDropdown)
            {
                <button type="button"
                        class="app-navbar-link @(IsDropdownActive(link) ? "active" : "")"
                        @onclick="() => OnDropdownToggle.InvokeAsync(link)"
                        aria-haspopup="true"
                        aria-expanded="@(IsDropdownActive(link).ToString().ToLowerInvariant())">
                    @link.Label
                    <svg class="chevron" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            }
            else
            {
                <NavLink href="@link.Href" class="app-navbar-link" @onclick="() => OnLinkClick.InvokeAsync()">
                    @link.Label
                </NavLink>
            }
        </li>
    }
</ul>