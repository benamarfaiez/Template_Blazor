@inherits AppComponentBase

@if (IsVisible)
{
    <div class="app-navbar-wrapper">

        @if (_activeDropdown is not null || _isMobileMenuOpen)
        {
            <div class="app-navbar-backdrop" @onclick="CloseAll" @oncontextmenu="CloseAll" @oncontextmenu:preventDefault="true"></div>
        }

        <nav class="app-navbar" @attributes="SafeAttributes">
            <div class="app-navbar-container">

                <AppNavBarBrand Brand="Brand" BrandTemplate="BrandTemplate" OnClick="CloseAll" />

                <AppNavBarLinks Links="Links"
                                IsMobileMenuOpen="_isMobileMenuOpen"
                                ActiveDropdown="_activeDropdown"
                                OnLinkClick="CloseAll"
                                OnDropdownToggle="ToggleDropdown"
                                OnMouseEnter="OnMouseEnterAsync"
                                OnMouseLeave="OnMouseLeaveAsync">
                    <DropdownContent>
                        @if (_activeDropdown is not null)
                        {
                            <div @onmouseenter="() => OnMouseEnterAsync(_activeDropdown)"
                                 @onmouseleave="() => OnMouseLeaveAsync()">
                                <AppNavBarMegaMenu ActiveLink="_activeDropdown" OnLinkClick="CloseAll" />
                            </div>
                        }
                    </DropdownContent>
                </AppNavBarLinks>

                <div class="app-navbar-right">
                    @RightContent
                </div>

                <button class="app-navbar-hamburger @(_isMobileMenuOpen ? "is-active" : "")"
                        @onclick="ToggleMobileMenu" @onclick:stopPropagation="true" aria-label="Menu">
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                </button>
            </div>
        </nav>
    </div>
}