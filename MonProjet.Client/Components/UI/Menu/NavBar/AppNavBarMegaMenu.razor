@inherits AppComponentBase

@if (IsVisible && ActiveLink is not null && ActiveLink.Groups is not null && ActiveLink.Groups.Any())
{
    <div class="app-megamenu" @attributes="SafeAttributes">
        <div class="app-megamenu-content">

            <!-- Bannière dynamique -->
            @if (!string.IsNullOrWhiteSpace(ActiveLink.BannerText))
            {
                <div class="app-megamenu-banner">
                    <span>@ActiveLink.BannerText</span>
                    @if (!string.IsNullOrWhiteSpace(ActiveLink.BannerLinkText))
                    {
                        <a href="@(ActiveLink.BannerLinkUrl ?? "#")" @onclick="HandleLinkClickAsync">
                            @ActiveLink.BannerLinkText &rarr;
                        </a>
                    }
                </div>
            }

            <!-- Grille des catégories -->
            <div class="app-megamenu-grid">
                @foreach (var group in ActiveLink.Groups)
                {
                    <AppNavBarMegaMenuGroup @key="group" Group="group" OnItemClick="HandleLinkClickAsync" />
                }
            </div>

        </div>
    </div>
}