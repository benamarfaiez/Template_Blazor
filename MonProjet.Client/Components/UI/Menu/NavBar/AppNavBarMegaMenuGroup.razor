@using MonProjet.Client.Models.UI.Menu.NavBar
@inherits AppComponentBase

<div class="app-megamenu-group" @attributes="SafeAttributes">
    <h4 class="group-title">
        <span class="dot"></span> @Group.Title
    </h4>
    <ul class="group-items">
        @foreach (var item in Group.Items)
        {
            <li>
                <AppNavBarMegaMenuItem Item="item" />
            </li>
        }
    </ul>
</div>

@code {
    [Parameter] public MegaMenuGroup Group { get; set; } = default!;
}