@using MonProjet.Client.Models.UI.Menu.NavBar
@inherits AppComponentBase

<div class="mega-item-wrapper">
    <NavLink href="@Item.Href" class="mega-item" @onclick="HandleClickAsync" @attributes="SafeAttributes">
        <div class="mega-icon">@Item.Icon</div>
        <div class="mega-text">
            <div class="mega-title">
                @Item.Title
                @if (!string.IsNullOrEmpty(Item.Badge))
                {
                    <span class="mega-badge">@Item.Badge</span>
                }
            </div>
            <div class="mega-desc">@Item.Description</div>
        </div>
    </NavLink>
</div>

@code {
    [Parameter] public MegaMenuItem Item { get; set; } = default!;
    [Parameter] public EventCallback OnClick { get; set; }

    private Task HandleClickAsync() => OnClick.InvokeAsync();
}