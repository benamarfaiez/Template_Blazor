@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Start" VerticalAlignment="@ContainerAlignment.Center"
              IsEnabled="@(!Disabled && !Loading)" IsVisible="@IsVisible">
    <button type="button"
            class="app-button @VariantClass"
            @onclick="HandleClick"
            disabled="@(Disabled || Loading)"
            aria-busy="@Loading.ToString().ToLowerInvariant()"
            @attributes="AdditionalAttributes">
            
        @if (Loading)
        {
            <span class="app-button-spinner" aria-hidden="true"></span>
        }
        @Text
    </button>

</AppContainer>