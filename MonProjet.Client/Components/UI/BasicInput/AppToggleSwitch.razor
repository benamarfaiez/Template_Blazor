@inherits AppComponentBase

<label class="app-toggle">
    <input type="checkbox" checked="@Value" @onchange="OnChanged" disabled="@Disabled" />
    <span class="app-toggle-slider"></span>
    <span class="app-toggle-label">@Label</span>
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    private Task OnChanged(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is true);
}