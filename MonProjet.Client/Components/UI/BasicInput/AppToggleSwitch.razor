@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Start" VerticalAlignment="@ContainerAlignment.Center"
              IsEnabled="@(!Disabled)" IsVisible="@IsVisible">

    <label class="app-toggle" for="@_inputId">

        @if (Position == LabelPlacement.Before && !string.IsNullOrWhiteSpace(Label))
        {
            <span class="app-toggle-label">@Label</span>
        }

        <input type="checkbox"
               id="@_inputId"
               role="switch"
               aria-checked="@Value.ToString().ToLowerInvariant()"
               checked="@Value"
               @onchange="OnChanged"
               disabled="@Disabled"
               @attributes="SafeAttributes" />

        <span class="app-toggle-slider"></span>

        @if (Position == LabelPlacement.After && !string.IsNullOrWhiteSpace(Label))
        {
            <span class="app-toggle-label">@Label</span>
        }

    </label>

</AppContainer>