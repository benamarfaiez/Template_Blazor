@inherits AppComponentBase

<AppContainer Width="@Width" Height="@Height"
              MarginLeft="@MarginLeft" MarginRight="@MarginRight" MarginTop="@MarginTop" MarginBottom="@MarginBottom"
              PaddingLeft="@PaddingLeft" PaddingRight="@PaddingRight" PaddingTop="@PaddingTop" PaddingBottom="@PaddingBottom"
              HorizontalAlignment="@ContainerAlignment.Start" VerticalAlignment="@ContainerAlignment.Center"
              IsVisible="@IsVisible">

    <div class="app-dropdown"
         tabindex="-1"
         @ref="_dropdownElement"
         @onkeydown="HandleKeyDownAsync"
         @onmouseenter="OnMouseEnterAsync"
         @onmouseleave="OnMouseLeaveAsync"
         @attributes="SafeAttributes">

        @if (IsOpen && !TriggerOnHover)
        {
            <div class="app-dropdown-backdrop" @onclick="CloseAsync"></div>
        }

        <AppButton Text="@Text" OnClick="ToggleAsync" Variant="@Variant" />

        @if (IsOpen)
        {
            <div class="app-dropdown-menu" @onclick:stopPropagation="true">
                @ChildContent
            </div>
        }

    </div>

</AppContainer>