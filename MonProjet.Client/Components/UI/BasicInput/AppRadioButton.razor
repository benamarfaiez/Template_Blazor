@inherits AppComponentBase

<label class="app-radio">
    <input type="radio" name="@GroupName" value="@Value" checked="@(Value == CurrentValue)"
           @onchange="OnChanged" disabled="@Disabled" />
    <span>@Label</span>
</label>

@code {
    [Parameter] public string GroupName { get; set; } = "radio-group";
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? CurrentValue { get; set; }
    [Parameter] public EventCallback<string> CurrentValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    private Task OnChanged() => CurrentValueChanged.InvokeAsync(Value);
}