@using MonProjet.Client.Components.UI.Menu.NavBar
@inherits LayoutComponentBase

<div class="layout">
    
    <!-- 1. LA BARRE DE NAVIGATION PRINCIPALE -->
    <AppNavBar Links="_navLinks" Href="/">
        
        <!-- Le logo personnalisé -->
        <BrandTemplate>
            <img src="/images/logo.svg" alt="Logo" />
        </BrandTemplate>

        <!-- Les boutons à droite -->
        <RightContent>
            <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 0.875rem; font-weight: 500; color: #475569;">GB EN ▾</span>
                <AppButton Text="Contact us" Variant="ButtonVariant.Secondary" />
                <AppButton Text="Explore the platform" 
                           Variant="ButtonVariant.Primary" 
                           style="background-color: #fcd34d; color: #0f172a; border: none; font-weight: 600;" />
            </div>
        </RightContent>
    </AppNavBar>

    <!-- 2. LE CONTENU DES PAGES -->
    <main class="layout-main">
        <AppContainer HorizontalAlignment="@ContainerAlignment.Center"
                      Width="100%" 
                      MaxWidth="1400px" 
                      PaddingLeft="32px" 
                      PaddingRight="32px" 
                      PaddingTop="32px"
                      PaddingBottom="32px">
                      
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <div style="display: flex; justify-content: center; margin-top: 48px;">
                        <AppCard style="max-width: 500px; text-align: center; border-top: 4px solid #dc2626;">
                            <h2>Oups ! Une erreur est survenue</h2>
                            <p style="color: #64748b;">@ex.Message</p>
                            <AppButton Text="Réessayer" OnClick="Recover" MarginTop="16px" />
                        </AppCard>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </AppContainer>
    </main>

    <!-- 3. LE FOOTER -->
    <AppFooter BrandName="Flowic">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/cgu">CGU</a>
        <a href="/contact">Contact</a>
    </AppFooter>
    
</div>