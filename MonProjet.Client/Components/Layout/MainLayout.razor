@inherits LayoutComponentBase
@using MonProjet.Client.Components.UI.Menu

<div class="layout">

    <AppNavBar Brand="MonProjet" Links="_navLinks">

        <RightContent>
            <AppStackPanel Orientation="StackOrientation.Horizontal" CrossAxisAlignment="StackAlignment.Center" Gap="16">
                <span style="font-size: 0.875rem; font-weight: 500; color: #475569; cursor: pointer;">GB EN ▾</span>

                <AppButton Text="Contact us" Variant="ButtonVariant.Secondary" />

                <AppButton Text="Explore the platform"
                           Variant="ButtonVariant.Primary"
                           style="background-color: #fcd34d; color: #0f172a; border: none; font-weight: 600;" />
            </AppStackPanel>
        </RightContent>

    </AppNavBar>

    <main class="layout-main">
        <AppContainer HorizontalAlignment="@ContainerAlignment.Center"
                      Width="100%"
                      MaxWidth="1200px"
                      PaddingLeft="24px"
                      PaddingRight="24px"
                      PaddingTop="32px"
                      PaddingBottom="32px">

            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-container">
                        <AppCard>
                            <h2>Oups ! Une erreur est survenue</h2>
                            <p class="error-message">@ex.Message</p>
                            <AppButton Text="Réessayer" OnClick="Recover" />
                        </AppCard>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </AppContainer>
    </main>

    <AppFooter BrandName="MonProjet">
        <a href="/mentions-legales" class="footer-link">Mentions légales</a>
        <a href="/cgu" class="footer-link">CGU</a>
        <a href="/contact" class="footer-link">Contact</a>
    </AppFooter>

</div>