@using MonProjet.Client.Components.UI.Menu.NavBar
@inherits LayoutComponentBase

<div class="layout">

    <!-- 1. LA BARRE DE NAVIGATION PRINCIPALE -->
    <AppNavBar Links="_navLinks">
        
        <BrandTemplate>
            <img src="/images/logo.svg" alt="Logo" />
        </BrandTemplate>

        <!-- Les boutons à droite -->
        <RightContent>
            <AppLanguageSelector />
            <ThemeToggle />
        </RightContent>
    </AppNavBar>

    <main class="layout-main" @key="LanguageService.CurrentCulture">
        <AppContainer HorizontalAlignment="@ContainerAlignment.Center" Width="100%" MaxWidth="1200px" PaddingLeft="24px" PaddingRight="24px" PaddingTop="32px" PaddingBottom="32px">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-container">
                        <AppCard>
                            <h2>Oups ! Une erreur est survenue</h2>
                            <p class="error-message">@ex.Message</p>
                            <AppButton Text="@Loc["Btn_Refresh"]" OnClick="Recover" />
                        </AppCard>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </AppContainer>
    </main>

    <AppFooter BrandName="Flowic">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/cgu">CGU</a>
        <a href="/contact">Contact</a>
    </AppFooter>

    <AppToast />
</div>