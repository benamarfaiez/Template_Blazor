<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MonProjet.Client</RootNamespace>
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
  </ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\*.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>%(Filename).Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<Compile Update="Resources\*.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>%(Filename).resx</DependentUpon>
		</Compile>
	</ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\MonProjet.Shared\MonProjet.Shared.csproj" />
  </ItemGroup>
	
  <ItemGroup>
    <Compile Update="Resources\HomeResource.Designer.cs">
      <DependentUpon>HomeResource.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\SharedResource.Designer.cs">
      <DependentUpon>SharedResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>